// HAPI Apple Platform Showcase - Schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

generator erd {
  provider        = "prisma-erd-generator"
  output          = "ERD.md"
  renderer        = "mermaid"
  theme           = "dark"
  includeComments = true
  showIndexes     = true
}

model Category {
  id       String            @id @default(uuid()) @db.Uuid
  name     String            @unique
  projects ProjectCategory[]
}

model Showcase {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  year          Int
  semester      Int
  description   String?
  publishedDate DateTime? /// null or future = unpublished

  projects Project[]
  slugs    ShowcaseSlug[]
  views    ShowcaseView[]

  @@unique([name, year, semester])
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  password              String
  name                  String
  role                  UserRole
  needsPasswordReset    Boolean                @default(false)
  Session               Session[]
  passwordResetRequest  PasswordResetRequest[]
  projectOwnerships     ProjectOwner[]
  videoTranscodeCredits Int? // 1 credit === 1 minute of transcode, null means unlimited (admins)
  reviewedVersions      ProjectVersion[]
}

enum UserRole {
  ADMIN
  STUDENT
}

model Session {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiry DateTime
}

model Project {
  id         String           @id @default(uuid()) @db.Uuid
  canBeHero  Boolean          @default(false)
  order      String? /// Lexo-rank
  showcaseId String           @db.Uuid
  showcase   Showcase         @relation(fields: [showcaseId], references: [id])
  published  Boolean
  featured   Boolean
  slugs      ProjectSlug[]
  versions   ProjectVersion[]
  ownerships ProjectOwner[]
  media      ProjectMedia[]
  views      ProjectView[]
}

model ProjectVersion {
  id               String                @id @default(uuid()) @db.Uuid
  projectId        String                @db.Uuid
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  subtitle         String?
  description      String
  iconUrl          String
  developerNames   String[]
  submissionStatus SubmissionStatus      @default(NOT_SUBMITTED)
  rejectionReason  String? /// only relevant when submissionStatus = REJECTED
  reviewerId       String?               @db.Uuid
  reviewer         User?                 @relation(fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  links            String[] /// parsed on frontend (GitHub/App Store/etc.)
  heroArtUrl       String?
  categories       ProjectCategory[]
  media            ProjectVersionMedia[]
  createdAt        DateTime
  submittedAt      DateTime?
}

model ProjectOwner {
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId   String  @db.Uuid
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, projectId])
}

model ProjectMedia {
  id                String                @id @default(uuid()) @db.Uuid
  projectId         String                @db.Uuid
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaUrl          String                @unique
  mediaType         MediaType
  status            MediaStatus
  createdAt         DateTime              @default(now()) /// unlinked media is kept for a grace period, as it may not be saved to a version yet
  versionInclusions ProjectVersionMedia[]
}

model ProjectVersionMedia {
  mediaId          String         @db.Uuid
  media            ProjectMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  projectVersionId String         @db.Uuid
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  order            String /// Lexo-rank
  deviceType       DeviceType

  @@id([projectVersionId, mediaId])
}

model ProjectCategory {
  categoryId       String         @db.Uuid
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projectVersionId String         @db.Uuid
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)

  @@id([projectVersionId, categoryId])
}

model ProjectSlug {
  slug         String   @id
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedDate DateTime @db.Timestamptz()
}

model ShowcaseSlug {
  slug         String   @id
  showcaseId   String   @db.Uuid
  showcase     Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  assignedDate DateTime @db.Timestamptz()
}

model PasswordResetRequest {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiry DateTime?
  code   String
}

model ProjectView {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewDate  DateTime
}

model ShowcaseView {
  id         String   @id @default(uuid()) @db.Uuid
  showcaseId String   @db.Uuid
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  viewDate   DateTime
}

enum MediaType {
  SCREENSHOT
  VIDEO
}

enum MediaStatus {
  AVAILABLE
  PENDING
  FAILED
}

enum DeviceType {
  PHONE
  TABLET
  DESKTOP
  AR
  WATCH
  TV
}

enum SubmissionStatus {
  NOT_SUBMITTED // newly created version
  PENDING // version submitted, pending approval
  APPROVED // version is live to public (assuming Project and Showcase published)
  REJECTED
  SUPERSEDED // previously approved version, replaced by new approved version
}
