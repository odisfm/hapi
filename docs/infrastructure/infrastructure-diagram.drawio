<mxfile host="drawio">
  <diagram name="HAPI infrastructure" id="hapi-infra">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Containers (drawn first so they sit behind everything) -->
        <mxCell id="account" value="RACE AWS account · ap-southeast-2 (Sydney)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="1180" height="860" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="VPC hapi-prod (10.10.0.0/16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8F0;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="900" height="560" as="geometry" />
        </mxCell>
        <mxCell id="public" value="Public subnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="private" value="Private subnets (2 AZs) · no inbound internet access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="620" height="500" as="geometry" />
        </mxCell>
        <mxCell id="lambdas" value="Lambdas (Node 24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="200" height="300" as="geometry" />
        </mxCell>

        <!-- Outside AWS -->
        <mxCell id="browser" value="Visitors, students, admins&lt;br&gt;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Maintainer's laptop&lt;br&gt;(AWS CLI, tofu, psql)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;Mailgun (email)&lt;br&gt;npm, OpenTofu downloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Edge services -->
        <mxCell id="cloudfront" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;one domain for everything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5E6FF;strokeColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;website · icons · media (screenshots, video)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#3F8624;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="&lt;b&gt;API Gateway&lt;/b&gt; (HTTP API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mediaconvert" value="&lt;b&gt;MediaConvert&lt;/b&gt;&lt;br&gt;video → WebM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="900" y="60" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;Mailgun key · RDS master password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="1160" y="320" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;Mondays 03:00 Melbourne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="1160" y="560" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="codecommit" value="&lt;b&gt;CodeCommit&lt;/b&gt; repo &lt;i&gt;hapi&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="1160" y="680" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="&lt;b&gt;EventBridge rule&lt;/b&gt;&lt;br&gt;push to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="1160" y="770" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="&lt;b&gt;SSM Session Manager&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Inside the VPC -->
        <mxCell id="nat" value="&lt;b&gt;fck-nat&lt;/b&gt; (t4g.nano)&lt;br&gt;Auto Scaling group of 1&lt;br&gt;fixed ENI + Elastic IP&lt;br&gt;patched weekly by SSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="280" y="400" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api (Hono)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="540" y="420" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tin" value="transcode_in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tout" value="transcode_out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="540" y="540" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="media_cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="540" y="600" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="codebuild" value="&lt;b&gt;CodeBuild&lt;/b&gt; hapi-prod-deploy&lt;br&gt;checks → db → migrate → app → website" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="520" y="740" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL 17&lt;/b&gt;&lt;br&gt;db.t4g.micro, single-AZ&lt;br&gt;IAM auth · TLS · 7-day backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="860" y="500" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3ep" value="S3 gateway endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;" vertex="1" parent="1">
          <mxGeometry x="880" y="380" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Request path -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="/, /icons, /media" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cloudfront" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cloudfront" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="668" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Lambdas to their dependencies -->
        <mxCell id="e5" value="IAM auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lambdas" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lambdas" target="s3ep">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s3ep" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="160" />
              <mxPoint x="710" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="outbound internet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lambdas" target="nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="nat" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="via NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="lambdas" target="secrets">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="368" />
              <mxPoint x="1140" y="368" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Video pipeline -->
        <mxCell id="e11" value="upload&lt;br&gt;events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="s3" target="tin">
          <mxGeometry x="-0.55" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="280" />
              <mxPoint x="760" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="start job&lt;br&gt;(via NAT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="tin" target="mediaconvert">
          <mxGeometry x="0.35" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="500" />
              <mxPoint x="830" y="140" />
              <mxPoint x="980" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="WebM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="mediaconvert" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="scheduler" target="cleanup">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="590" />
              <mxPoint x="1150" y="660" />
              <mxPoint x="620" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Pipeline -->
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="codecommit" target="trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="start build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="trigger" target="codebuild">
          <mxGeometry x="-0.6" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="db roles, migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="codebuild" target="rds">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="915" y="755" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e18" value="source, packages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="codebuild" target="nat">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Human database access -->
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="admin" target="ssm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="port forward" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ssm" target="nat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="345" />
              <mxPoint x="230" y="422" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="tunnel to 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="nat" target="rds">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="415" y="710" />
              <mxPoint x="1025" y="710" />
            </Array>
