{
  "name": "hapi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "client",
    "shared"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "api:dev": "dotenv -e .env -- sh -c 'npm run dev --workspace api'",
    "client:dev": "dotenv -e .env -- sh -c 'npm run dev --workspace client'"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.23.1"
  },
  "dependencies": {
    "@dalet-oss/lexorank": "^1.1.5",
    "aws-lambda": "^1.0.7"
  }
}
