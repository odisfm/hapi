{
  "name": "hapi",
  "private": true,
  "workspaces": [
    "api",
    "client",
    "shared"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "api:dev": "dotenv -e .env -- sh -c 'npm run dev --workspace api'",
    "client:dev": "dotenv -e .env -- sh -c 'npm run dev --workspace client'"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "overrides": { "deepmerge-ts": "^8.0.1" }
}
