// HAPI Apple Platform Showcase - Schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

generator erd {
  provider        = "prisma-erd-generator"
  output          = "ERD.md"
  renderer        = "mermaid"
  theme           = "dark"
  includeComments = true
  showIndexes     = true
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  projects Project[]
}

model Showcase {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  year          Int
  semester      Int
  description   String?
  publishedDate DateTime? /// null or future = unpublished

  projects Project[]

  @@unique([name, year, semester])
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  email                String                 @unique
  password             String
  name                 String
  role                 UserRole
  needsPasswordReset   Boolean                @default(false)
  Session              Session[]
  passwordResetRequest PasswordResetRequest[]
}

enum UserRole {
  ADMIN
}

model Session {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiry DateTime
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  subtitle        String?
  description     String
  iconUrl         String
  developers      String[]
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String? /// only relevant when approvalStatus = REJECTED
  links           String[] /// parsed on frontend (GitHub/App Store/etc.)
  order           String? /// Lexo-rank
  categoryId      String         @db.Uuid
  category        Category       @relation(fields: [categoryId], references: [id])
  showcaseId      String         @db.Uuid
  showcase        Showcase       @relation(fields: [showcaseId], references: [id])
  published       Boolean
  featured        Boolean

  media ProjectMedia[]
  slugs ProjectSlug[]
}

model ProjectMedia {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaUrl   String      @unique
  mediaType  MediaType
  deviceType DeviceType
  order      String /// Lexo-rank
  status     MediaStatus
}

model ProjectSlug {
  slug         String   @id
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedDate DateTime @db.Timestamptz()
}

model PasswordResetRequest {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  user   User      @relation(fields: [userId], references: [id])
  expiry DateTime?
  code   String
}

enum MediaType {
  SCREENSHOT
  VIDEO
}

enum MediaStatus {
  AVAILABLE
  PENDING
  FAILED
}

enum DeviceType {
  PHONE
  TABLET
  DESKTOP
  AR
  WATCH
  TV
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
