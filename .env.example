# Local development settings. Copy to `.env` (never commit `.env`).
# See docs/dev/dev-environment.md. Production does not use this file: the
# pipeline and infra/ configure the deployed site.

# --- Database ---------------------------------------------------------------
# Supabase Local (started with `npx supabase start` in shared/).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- API --------------------------------------------------------------------
# Origins allowed to call the API with cookies (space-separated).
ALLOWED_CORS="http://localhost:5173"
# Optional: delay every API response by about this many ms (+/- 20%), to
# simulate a real network.
SERVER_DELAY="50"

# Email: "mock" prints emails in the API's terminal instead of sending them.
# Other values: "mailgun" (needs MAILGUN_KEY and EMAIL_DOMAIN) or "aws" (SES,
# unused). Keep "mock" for local development.
EMAIL_PROVIDER="mock"
MAILGUN_KEY=""
EMAIL_DOMAIN=""

# --- Website ----------------------------------------------------------------
# Where the website calls the API.
VITE_API_URL="http://localhost:3000"

# Optional Umami analytics. Leave empty locally.
VITE_UMAMI_SCRIPT_URL=""
VITE_UMAMI_WEBSITE_ID=""
VITE_UMAMI_DASHBOARD_URL=""

# --- Demo data (npm run db:populate --workspace shared) ---------------------
# Logins created by the demo-data script. Passwords need 8+ characters with
# upper and lower case, a number and a symbol.
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="LocalDev1!"
# Optional students: comma-separated, same number of each.
DEFAULT_STUDENT_EMAILS="student@example.com"
DEFAULT_STUDENT_PASSWORDS="LocalDev1!"
DEFAULT_STUDENT_NAMES="Sam Student"

# --- Media (optional) -------------------------------------------------------
# Needed only to show images and upload media locally. Use the shared dev
# buckets (infra/local_dev), never the production ones. Get the values with
#   tofu -chdir=infra/local_dev output -raw env_file
# See "Media" in docs/dev/dev-environment.md.
# Bucket names the API uploads to:
BUCKET_ICONS=""
BUCKET_MEDIA=""
# Public base URLs the website loads images from (ending in "/"):
VITE_S3_ICON_BUCKET=""
VITE_S3_MEDIA_BUCKET=""
# AWS credentials for those buckets: a profile from `aws configure`.
AWS_PROFILE=""
AWS_REGION="ap-southeast-2"
