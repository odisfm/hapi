// HAPI Apple Platform Showcase - Schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "esm"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  projects Project[]
}

model Showcase {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  year          Int
  semester      String
  description   String?
  publishedDate DateTime? // null or future = unpublished

  projects Project[]

  @@unique([name, year, semester])
}

model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique
  password String
  name     String
  role     UserRole
}

enum UserRole {
  ADMIN
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  subtitle        String?
  description     String
  iconUrl         String
  developers      String[]
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?        // only relevant when approvalStatus = REJECTED
  links           String[]       // parsed on frontend (GitHub/App Store/etc.)
  order           String?        // Lexo-rank
  categoryId      String         @db.Uuid
  category        Category       @relation(fields: [categoryId], references: [id])
  showcaseId      String         @db.Uuid
  showcase        Showcase       @relation(fields: [showcaseId], references: [id])

  media ProjectMedia[]
}

model ProjectMedia {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @db.Uuid
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaUrl   String
  mediaType  MediaType
  deviceType DeviceType
  order      String     // Lexo-rank
}

enum MediaType {
  SCREENSHOT
  VIDEO
}

enum DeviceType {
  PHONE
  TABLET
  DESKTOP
  AR
  WATCH
  TV
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
